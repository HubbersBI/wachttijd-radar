# Optional. Without a key the assistant falls back to rule-based matching, which is
# good enough to demo but does not understand lay terms like "nieuwe heup".
# Free tier, no card: https://console.groq.com -> API Keys
GROQ_API_KEY=

# Optional. Groq's free line-up changes; check console.groq.com for what is current.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. "true" forces the rule-based parser even when a key is set.
# Used by the tests, so the suite needs no key, no quota and no network.
WACHTTIJD_LLM_MOCK=false

# Optional. Host port for docker compose, when 8000 is taken.
WACHTTIJD_PORT=8000
